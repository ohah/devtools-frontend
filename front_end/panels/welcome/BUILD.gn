import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")

devtools_ui_module("welcome") {
  sources = [
    "WelcomePanel.ts",
  ]

  deps = [
    "../../core/i18n:bundle",
    "../../ui/helpers:bundle",
    "../../ui/kit:bundle",
    "../../ui/legacy:bundle",
    "../../ui/lit:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "welcome.ts"

  deps = [
    ":welcome",
  ]

  visibility = [ ":*" ]
}

devtools_entrypoint("meta") {
  entrypoint = "welcome-meta.ts"

  deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
  ]

  visibility = [
    "../..:*",
    "../../entrypoints/devtools_app:*",
    "../../entrypoints/inspector:*",
  ]
}

