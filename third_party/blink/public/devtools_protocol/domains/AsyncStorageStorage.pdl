# Query and modify AsyncStorage storage.
experimental domain AsyncStorageStorage

  # AsyncStorage Storage item (key-value pair).
  type Item extends array of string

  # Enables storage tracking, storage events will now be delivered to the client.
  command enable

  command getAsyncStorageItems
    parameters
      string instanceId
    returns
      array of Item entries

  command setAsyncStorageItem
    parameters
      string instanceId
      string key
      string value

  command removeAsyncStorageItem
    parameters
      string instanceId
      string key

  command clear
    parameters
      string instanceId

  event asyncStorageItemsCleared
    parameters
      string instanceId

  event asyncStorageItemRemoved
    parameters
      string instanceId
      string key

  event asyncStorageItemAdded
    parameters
      string instanceId
      string key
      string newValue

  event asyncStorageItemUpdated
    parameters
      string instanceId
      string key
      string oldValue
      string newValue

  event asyncStorageInstanceCreated
    parameters
      string instanceId
