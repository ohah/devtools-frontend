# Query and modify MMKV storage.
experimental domain MMKVStorage

  # MMKV Storage item: [key, value, valueType]. valueType is string, number, boolean, or buffer.
  type Item extends array of string

  # MMKV value type.
  type ValueType extends string
    enum
      string
      number
      boolean
      buffer

  # Enables storage tracking, storage events will now be delivered to the client.
  command enable

  command getMMKVItems
    parameters
      string instanceId
    returns
      array of Item entries

  command setMMKVItem
    parameters
      string instanceId
      string key
      string value
      # One of string, number, boolean, buffer.
      optional ValueType valueType

  command removeMMKVItem
    parameters
      string instanceId
      string key

  command clear
    parameters
      string instanceId

  event mmkvItemsCleared
    parameters
      string instanceId

  event mmkvItemRemoved
    parameters
      string instanceId
      string key

  event mmkvItemAdded
    parameters
      string instanceId
      string key
      string newValue
      optional ValueType valueType

  event mmkvItemUpdated
    parameters
      string instanceId
      string key
      string oldValue
      string newValue
      optional ValueType valueType

  event mmkvInstanceCreated
    parameters
      string instanceId
