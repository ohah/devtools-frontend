# Query and modify MMKV storage.
experimental domain MMKVStorage

  # MMKV Storage item (key-value pair).
  type Item extends array of string

  # Enables storage tracking, storage events will now be delivered to the client.
  command enable

  command getMMKVItems
    parameters
      string instanceId
    returns
      array of Item entries

  command setMMKVItem
    parameters
      string instanceId
      string key
      string value

  command removeMMKVItem
    parameters
      string instanceId
      string key

  command clear
    parameters
      string instanceId

  event mmkvItemsCleared
    parameters
      string instanceId

  event mmkvItemRemoved
    parameters
      string instanceId
      string key

  event mmkvItemAdded
    parameters
      string instanceId
      string key
      string newValue

  event mmkvItemUpdated
    parameters
      string instanceId
      string key
      string oldValue
      string newValue

  event mmkvInstanceCreated
    parameters
      string instanceId
