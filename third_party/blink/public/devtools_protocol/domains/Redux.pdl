# Contributing to Chrome DevTools Protocol: https://goo.gle/devtools-contribution-guide-cdp

# Redux domain allows tracking Redux state changes and actions in the application.
# It provides integration with Redux DevTools Extension for debugging Redux applications.
domain Redux
  depends on Runtime

  # Redux message type matching Redux DevTools Extension format / Redux DevTools Extension 형식과 일치하는 Redux 메시지 타입
  type MessageType extends string
    enum
      INIT_INSTANCE
      INIT
      ACTION
      STATE
      ERROR

  # Sends a Redux message from the application to DevTools or vice versa.
  # This is the unified method that handles all Redux message types.
  # Matches Redux DevTools Extension message format exactly / Redux DevTools Extension 메시지 형식과 정확히 일치
  command message
    parameters
      # Message type.
      MessageType type
      # Action payload (JSON string, for ACTION type).
      optional string action
      # State payload (JSON string, for INIT and ACTION types).
      optional string payload
      # Source of the message (e.g., "@devtools-page", "@devtools-extension").
      string source
      # Instance ID of the Redux store.
      integer instanceId
      # Store name (for INIT type).
      optional string name
      # Maximum age of actions to keep (for ACTION type).
      optional integer maxAge
      # Next action ID (for ACTION type).
      optional integer nextActionId
      # Error message (for ERROR type).
      optional string error
      # Timestamp when the message was created.
      optional Runtime.Timestamp timestamp

  # Issued when a Redux message is received from the application.
  # Matches Redux DevTools Extension message format exactly / Redux DevTools Extension 메시지 형식과 정확히 일치
  event message
    parameters
      # Message type.
      MessageType type
      # Action payload (JSON string, for ACTION type).
      optional string action
      # State payload (JSON string, for INIT and ACTION types).
      optional string payload
      # Source of the message (e.g., "@devtools-page", "@devtools-extension").
      string source
      # Instance ID of the Redux store.
      integer instanceId
      # Store name (for INIT type).
      optional string name
      # Maximum age of actions to keep (for ACTION type).
      optional integer maxAge
      # Next action ID (for ACTION type).
      optional integer nextActionId
      # Error message (for ERROR type).
      optional string error
      # Timestamp when the message was created.
      optional Runtime.Timestamp timestamp

