# SessionReplay domain handles recording and replaying user interactions using rrweb.
experimental domain SessionReplay

  # Enables the SessionReplay domain and automatically replays stored events.
  command enable
    returns
      # Whether the operation was successful.
      boolean success

  # Disables the SessionReplay domain.
  command disable
    returns
      # Whether the operation was successful.
      boolean success

  # Sends rrweb events as CDP events.
  command sendEvent
    parameters
      # Array of rrweb events to send.
      optional array of any events
    returns
      # Whether the operation was successful.
      boolean success

  # Replays stored SessionReplay events from IndexedDB.
  command replayStoredEvents
    returns
      # Whether the operation was successful.
      boolean success
      # Number of events replayed.
      optional integer count

  # Emitted when rrweb events are recorded.
  event eventRecorded
    parameters
      # Array of rrweb events.
      array of any events

